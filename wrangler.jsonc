{
  // Cloudflare Workers 配置（Git 集成自动部署会读取本文件）
  // 架构：worker.js 作门童 —— /.cloud/*、/media/*、/api/stripe/* 同源转发到云沙箱，
  // 其余全部走静态资产（Workers Assets，永不休眠，根治 www 530）。
  "name": "uslatiao-site",
  "compatibility_date": "2026-09-01",
  "main": "worker.js",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  // 关键：允许保留 Cloudflare 面板上添加的运行时变量（如 STRIPE_SECRET_KEY），
  // 否则每次 wrangler deploy 都会把面板上配置的 vars 清空。
  "keep_vars": true
}
